#!/bin/sh
# Validate the i18n setup before every commit.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Bypass for a single commit (e.g. work in progress):
#     git commit --no-verify

root=$(git rev-parse --show-toplevel) || exit 1

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 not found, skipping locale validation" >&2
    exit 0
fi

if ! python3 "$root/tools/validate-locales.py"; then
    echo >&2
    echo "pre-commit: locale validation failed — commit aborted." >&2
    echo "Fix the errors above, or bypass with: git commit --no-verify" >&2
    exit 1
fi

exit 0
