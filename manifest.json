{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3.1",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "permissions": ["storage"],
  "host_permissions": ["https://api.elevenlabs.io/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
